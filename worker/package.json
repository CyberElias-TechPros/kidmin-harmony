{
  "name": "kidmin-harmony-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply kidmin-harmony-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply kidmin-harmony-db --remote",
    "db:seed": "npx tsx src/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240801.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.3",
    "wrangler": "^3.78.0"
  }
}

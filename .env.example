# ---------------------------------------------------------------------------
# Frontend (Vercel)
# ---------------------------------------------------------------------------
# Optional: point the browser directly at the deployed Cloudflare Worker. If
# unset, the app calls a relative "/api" path which Vercel proxies to the Worker
# (see vercel.json, which uses the WORKER_URL env var set in Vercel settings).
VITE_API_URL=

# ---------------------------------------------------------------------------
# Backend (Cloudflare Worker) — set these as Wrangler secrets/vars, not in git.
# ---------------------------------------------------------------------------
# Required on the Worker. A long random string used to sign/verify JWTs.
JWT_SECRET=replace_with_a_long_random_string

# Comma-separated list of allowed CORS origins. Only needed if the frontend
# calls the Worker directly from a different origin (i.e. when VITE_API_URL is
# set). When using Vercel rewrites, leave blank ("*").
ALLOWED_ORIGINS=

# Only true for local development / demo. Enables POST /api/auth/seed which
# creates the admin@church.org / teacher@church.org / parent@church.org demo
# accounts. Disable in production.
SEED_DEMO=false

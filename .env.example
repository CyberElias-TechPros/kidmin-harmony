# ---------------------------------------------------------------------------
# Frontend (Vercel)
# ---------------------------------------------------------------------------
# Optional: point the browser directly at the deployed Cloudflare Worker. If
# unset, the app calls a relative "/api" path which Vercel proxies to the Worker
# (see vercel.json, which uses the WORKER_URL env var set in Vercel settings).
VITE_API_URL=

# ---------------------------------------------------------------------------
# Backend (Cloudflare Worker) — set these as Wrangler secrets/vars, not in git.
# ---------------------------------------------------------------------------
# Required on the Worker. A long random string used to sign/verify JWTs
# (minimum 16 characters). Example: `openssl rand -hex 32`.
JWT_SECRET=replace_with_a_long_random_string

# Comma-separated list of allowed CORS origins, e.g. https://kidmin.vercel.app
# Only needed when the frontend calls the Worker directly from a different
# origin (i.e. when VITE_API_URL is set). Leave blank when using the Vercel
# rewrites in vercel.json — requests arrive same-origin and no CORS header is
# required. Note: the Worker no longer accepts a wildcard "*" origin.
ALLOWED_ORIGINS=

# Optional: IANA timezone used to determine "today" (attendance sessions,
# event status). Defaults to UTC. Example: APP_TIMEZONE=Africa/Lagos
APP_TIMEZONE=

# Only for local development / demo. When true, POST /api/auth/seed creates
# the demo accounts (admin@church.org, teacher@church.org, parent@church.org).
# On a fresh (empty) database the seed may be called without authentication;
# once any user exists it requires an admin token. Do not set this in
# production.
SEED_DEMO=false
